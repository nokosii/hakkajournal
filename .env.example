JOURNAL_STORAGE=local
SESSION_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_EMAIL=editor@example.org
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=張陳基

# Render 正式環境改為 google。與「隨選客語 Podcast」相同，
# 建議用個人 Google Drive 資料夾搭配 OAuth：
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# 選用：若有 Google Workspace 共用雲端硬碟，也可改用服務帳戶 JSON。
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# 選用：Render Persistent Disk 掛載路徑；未設定時使用暫存快取。
DATA_DIR=

# 選用：本機若已有 PostgreSQL，可設定 DATABASE_URL 取代內建資料庫。
DATABASE_URL=

# AI 初步評閱（伺服器端使用；請勿加上 NEXT_PUBLIC_ 前綴）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
